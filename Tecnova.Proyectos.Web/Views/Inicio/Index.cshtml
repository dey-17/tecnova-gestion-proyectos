@model Newtonsoft.Json.Linq.JObject
@{ Layout = null; var admin = (int)Model["IdRol"] == 1; }
<!DOCTYPE html><html lang="es"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>Tecnova · Gestión de Proyectos</title><link rel="stylesheet" href="@Url.Content("~/Content/app.css")"/></head>
<body data-user-id="@Model["Id"]" data-role="@Model["IdRol"]">
<a class="skip-link" href="#contenido">Ir al contenido</a>
<aside><a class="brand" href="#panel"><span class="monogram">T.</span><span>TECNOVA<small>GESTIÓN DE PROYECTOS</small></span></a><p class="nav-label">ESPACIO DE TRABAJO</p>
<nav aria-label="Menú principal"><a href="#panel" data-nav="panel"><span aria-hidden="true">◫</span> Panel general</a><a href="#proyectos" data-nav="proyectos"><span aria-hidden="true">▤</span> Proyectos</a><a href="#tareas" data-nav="tareas"><span aria-hidden="true">✓</span> @(admin ? "Tareas" : "Mis tareas")</a>@if(admin){<a href="#usuarios" data-nav="usuarios"><span aria-hidden="true">♙</span> Usuarios</a>}</nav>
<div class="aside-bottom"><div class="user-mark">@(((string)Model["Nombre"]).Substring(0,1))</div><strong>@Model["Nombre"]</strong><span>@Model["Rol"]</span><button id="logout" type="button">Cerrar sesión <span aria-hidden="true">↗</span></button></div></aside>
<main><header><span id="breadcrumb">Espacio de trabajo / Panel general</span><span class="badge">@Model["Rol"]</span></header><div id="global-error" class="notice error" role="alert" hidden></div><div id="toast" class="notice success" role="status" hidden></div><section id="contenido" tabindex="-1" aria-live="polite"></section><footer>Tecnova · Gestión de Proyectos</footer></main>
<div id="csrf" hidden>@Html.AntiForgeryToken()</div>
<dialog id="editor" aria-labelledby="dialog-title"><div class="dialog-top"><div><p class="eyebrow">TECNOVA</p><h2 id="dialog-title"></h2></div><button id="close-dialog" type="button" class="icon-button" aria-label="Cerrar formulario">×</button></div><form id="editor-form" novalidate><div id="editor-fields"></div><p id="form-error" class="form-error" role="alert"></p><div class="form-actions"><button type="button" id="cancel-edit" class="secondary">Cancelar</button><button type="submit" class="primary" id="save-edit">Guardar cambios →</button></div></form></dialog>
<dialog id="confirm" aria-labelledby="confirm-title"><h2 id="confirm-title">Confirmar operación</h2><p id="confirm-text"></p><div class="form-actions"><button type="button" id="confirm-no" class="secondary">Cancelar</button><button type="button" id="confirm-yes" class="danger">Confirmar</button></div></dialog>
<script src="@Url.Content("~/Scripts/app.js")" defer></script></body></html>
